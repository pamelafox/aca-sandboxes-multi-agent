# ============================================================================
# Orchestrator local dev configuration (Python)
# ============================================================================
# Copy this file to `.env` (in this directory) when running the orchestrator
# locally with `uvicorn orchestrator:app`. NEVER commit `.env` to source control.
#
# In Azure (Container App), these values come from the Bicep deployment and
# this file is ignored.
# ============================================================================

# Azure subscription + resource group containing the sandbox group
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
RESOURCE_GROUP=rg-agents-demo

# Sandbox group provisioned by infra/main.bicep (output: sandboxGroupName)
SANDBOX_GROUP=aca-sandboxes-agents-sg-westus2
DEFAULT_REGION=westus2

# User-assigned identity attached to the sandbox group. These values are used
# when creating a disk image that pulls the research-agent image from ACR.
SANDBOX_GROUP_UAMI_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<identity-name>
SANDBOX_GROUP_UAMI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Research-agent image pushed to ACR (output: acrLoginServer + image)
DISK_IMAGE_ID=<acr-name>.azurecr.io/research-agent:latest

# Azure OpenAI (output: openAiEndpoint).
# AUTH IS KEYLESS — no AZURE_OPENAI_KEY is required.
# The orchestrator's planner uses DefaultAzureCredential (az login locally /
# managed identity in Azure); your principal needs the 'Cognitive Services
# OpenAI User' role on the AOAI account. Researcher sandboxes never receive a
# token: the egress proxy injects one for the sandbox group's managed identity.
AZURE_OPENAI_ENDPOINT=https://<openai-name>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna

# Foundry project used by the in-sandbox researcher for hosted web search.
FOUNDRY_PROJECT_ENDPOINT=https://<account-name>.services.ai.azure.com/api/projects/<project-name>
